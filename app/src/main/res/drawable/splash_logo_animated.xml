<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/apk/res-auto">
    <aapt:attr name="android:drawable">
        <vector
            android:width="200dp"
            android:height="200dp"
            android:viewportWidth="200"
            android:viewportHeight="200">
            
            <!-- Background circle -->
            <path
                android:name="background"
                android:pathData="M100,100m-90,0a90,90 0,1 1,180 0a90,90 0,1 1,-180 0"
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.1" />
            
            <!-- Tree with heart -->
            <group android:name="tree_group" android:pivotX="100" android:pivotY="100">
                <!-- Heart in the center -->
                <path
                    android:name="heart"
                    android:fillColor="#FFFFFF"
                    android:pathData="M100,110L85,95c-4,-4 -4,-10.5 0,-14.5c4,-4 10.5,-4 14.5,0c4,-4 10.5,-4 14.5,0c4,4 4,10.5 0,14.5L100,110z"/>
                
                <!-- Main trunk -->
                <path
                    android:name="trunk"
                    android:fillColor="#FFFFFF"
                    android:pathData="M97,110L97,140Q97,145 102,145Q107,145 107,140L107,110"/>
                
                <!-- Left branch -->
                <path
                    android:name="left_branch"
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M90,100Q70,90 50,75Q45,72 40,68"/>
                
                <!-- Right branch -->
                <path
                    android:name="right_branch"
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="3"
                    android:strokeLineCap="round"
                    android:pathData="M110,100Q130,90 150,75Q155,72 160,68"/>
                
                <!-- Small leaves -->
                <path
                    android:name="leaf1"
                    android:fillColor="#FFFFFF"
                    android:pathData="M38,64c-2,0 -3,-1 -3,-3s1,-3 3,-3s3,1 3,3S40,64 38,64z"/>
                
                <path
                    android:name="leaf2"
                    android:fillColor="#FFFFFF"
                    android:pathData="M162,64c-2,0 -3,-1 -3,-3s1,-3 3,-3s3,1 3,3S164,64 162,64z"/>
            </group>
        </vector>
    </aapt:attr>
    
    <!-- Scale animation -->
    <target android:name="tree_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="1000"
                android:valueFrom="0.5"
                android:valueTo="1.0"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
    
    <target android:name="tree_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="1000"
                android:valueFrom="0.5"
                android:valueTo="1.0"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </aapt:attr>
    </target>
    
    <!-- Alpha animation for background -->
    <target android:name="background">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:duration="1500"
                android:valueFrom="0.0"
                android:valueTo="0.1"
                android:interpolator="@android:anim/decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector> 